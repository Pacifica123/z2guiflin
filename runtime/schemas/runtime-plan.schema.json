{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zap2.local/schemas/runtime-plan.schema.json",
  "title": "Zap2 runtime plan contract",
  "type": "object",
  "required": [
    "schemaVersion",
    "planId",
    "title",
    "profileId",
    "strategyId",
    "action",
    "lifecycle",
    "safety",
    "sections",
    "rollbackNotes"
  ],
  "properties": {
    "schemaVersion": {"type": "integer", "const": 1},
    "planId": {"type": "string", "minLength": 3},
    "title": {"type": "string", "minLength": 3},
    "profileId": {"type": "string", "minLength": 1},
    "strategyId": {"type": "string", "minLength": 1},
    "action": {"type": "string", "enum": ["start", "stop", "status", "install-service", "remove-service"]},
    "lifecycle": {
      "type": "object",
      "required": ["contractStage", "bootstrapMixedIn", "automaticChecksMayExecute"],
      "properties": {
        "contractStage": {"type": "string", "const": "v0.3-alpha_stage_8"},
        "bootstrapMixedIn": {"type": "boolean", "const": false},
        "automaticChecksMayExecute": {"type": "boolean", "const": false}
      }
    },
    "safety": {
      "type": "object",
      "required": [
        "requiresOwnerConfirmation",
        "mayRequireSudoWhenExecutedByOwner",
        "mayMutateFirewallWhenExecutedByOwner",
        "mayManageServiceWhenExecutedByOwner",
        "containsRemoteBootstrap",
        "containsUpstreamInstallerScript"
      ],
      "properties": {
        "requiresOwnerConfirmation": {"type": "boolean", "const": true},
        "mayRequireSudoWhenExecutedByOwner": {"type": "boolean"},
        "mayMutateFirewallWhenExecutedByOwner": {"type": "boolean"},
        "mayManageServiceWhenExecutedByOwner": {"type": "boolean"},
        "containsRemoteBootstrap": {"type": "boolean", "const": false},
        "containsUpstreamInstallerScript": {"type": "boolean", "const": false}
      }
    },
    "sections": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["kind", "purpose", "steps"],
        "properties": {
          "kind": {"type": "string", "enum": ["run", "apply", "session", "service"]},
          "purpose": {"type": "string"},
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["stepId", "title", "description", "requiresOwnerConfirmation", "commands"],
              "properties": {
                "stepId": {"type": "string"},
                "title": {"type": "string"},
                "description": {"type": "string"},
                "requiresOwnerConfirmation": {"type": "boolean"},
                "commands": {"type": "array"}
              }
            }
          }
        }
      }
    },
    "rollbackNotes": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    }
  }
}
