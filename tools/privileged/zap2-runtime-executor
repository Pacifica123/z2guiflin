#!/usr/bin/python3 -I
"""Zap2 P02 finite privileged executor.

This file is intentionally standalone and imports only the Python standard
library.  It must be installed root-owned at /usr/local/libexec before the
normal GUI/CLI runtime can use it.  Requests arrive as canonical JSON bytes on
stdin; the helper never imports the writable project package and never accepts
an arbitrary executable, shell command, PYTHONPATH or command path.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import shlex
import signal
import stat
import subprocess
import sys
import time
from pathlib import Path
from typing import Any

VERSION = "p02-v1"
SCHEMA_VERSION = 1
PROTOCOL = "zap2-privilege-plan/v1"
RUN_BASE = Path("/run/zap2")
DANGEROUS_ENV = ("PYTHONPATH", "PYTHONHOME", "LD_PRELOAD", "LD_LIBRARY_PATH", "BASH_ENV", "ENV")
PLAN_TRANSIENT_FIELDS = {
    "planHash",
    "preparedAt",
    "confirmationRequired",
    "confirmed",
    "expiresWhenPlanChanges",
    "allowsAutomaticReuse",
    "confirmationId",
    "confirmedAt",
}
SAFE_NFT_PATHS = (Path("/usr/bin/nft"), Path("/usr/sbin/nft"))
NFT_NAME_RE = re.compile(r"^[A-Za-z0-9_]{1,96}$")
SAFE_PROFILE_RE = re.compile(r"^[A-Za-z0-9_.-]{1,80}$")
EXPECTED_NFQWS_REL = "core/zapret2/nfq2/nfqws2"
EXPECTED_START_STAGE = "v0.3-alpha_stage_10"


class ExecutorError(RuntimeError):
    pass


def stable_json(data: Any) -> str:
    return json.dumps(data, ensure_ascii=False, sort_keys=True, separators=(",", ":"))


def sha256_bytes(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def file_sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def plan_hash(plan: dict[str, Any]) -> str:
    payload = {key: value for key, value in plan.items() if key not in PLAN_TRANSIENT_FIELDS}
    return sha256_bytes(stable_json(payload).encode("utf-8"))


def helper_path() -> Path:
    return Path(sys.argv[0]).resolve()


def helper_provenance() -> dict[str, Any]:
    path = helper_path()
    info = path.stat()
    return {
        "version": VERSION,
        "path": str(path),
        "sha256": file_sha256(path),
        "uid": info.st_uid,
        "mode": stat.S_IMODE(info.st_mode),
        "ruid": os.getuid(),
        "euid": os.geteuid(),
        "sudoUid": os.environ.get("SUDO_UID"),
    }


def require_root_owned_helper() -> None:
    if os.geteuid() != 0:
        raise ExecutorError("executor requires euid=0")
    path = helper_path()
    info = path.stat()
    if not stat.S_ISREG(info.st_mode):
        raise ExecutorError("executor path is not a regular file")
    if info.st_uid != 0:
        raise ExecutorError("executor must be owned by root")
    if stat.S_IMODE(info.st_mode) & 0o022:
        raise ExecutorError("executor must not be group/world writable")
    for name in DANGEROUS_ENV:
        if os.environ.get(name):
            raise ExecutorError(f"dangerous environment is not allowed: {name}")


def require_root_owned_binary(path: Path) -> Path:
    info = path.stat()
    if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or stat.S_IMODE(info.st_mode) & 0o022:
        raise ExecutorError(f"system binary is not trusted: {path}")
    if not os.access(path, os.X_OK):
        raise ExecutorError(f"system binary is not executable: {path}")
    return path


def nft_binary() -> Path:
    for path in SAFE_NFT_PATHS:
        try:
            if path.exists():
                return require_root_owned_binary(path)
        except OSError:
            continue
    raise ExecutorError("trusted nft binary not found in fixed system paths")


def verify_plan_confirmation(plan: object, confirmation: object) -> tuple[dict[str, Any], dict[str, Any], str]:
    if not isinstance(plan, dict) or not isinstance(confirmation, dict):
        raise ExecutorError("plan/confirmation must be JSON objects")
    calculated = plan_hash(plan)
    if plan.get("planHash") != calculated:
        raise ExecutorError("planHash does not match plan bytes")
    if confirmation.get("planId") != plan.get("planId"):
        raise ExecutorError("confirmation planId mismatch")
    if confirmation.get("planHash") != calculated or confirmation.get("confirmedByOwner") is not True:
        raise ExecutorError("confirmation hash does not match privileged plan")
    if confirmation.get("allowsAutomaticReuse") is True:
        raise ExecutorError("reusable confirmations are not accepted")
    return plan, confirmation, calculated


def command_result(argv: list[str], *, input_bytes: bytes | None = None) -> dict[str, Any]:
    completed = subprocess.run(
        argv,
        input=input_bytes,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
        env={"PATH": "/usr/bin:/usr/sbin", "LANG": "C", "LC_ALL": "C"},
    )
    return {
        "argv": argv,
        "returncode": completed.returncode,
        "stdout": completed.stdout.decode("utf-8", errors="replace"),
        "stderr": completed.stderr.decode("utf-8", errors="replace"),
    }


def validate_table_name(value: object) -> str:
    table = str(value or "")
    if not NFT_NAME_RE.fullmatch(table):
        raise ExecutorError("invalid nft table identifier")
    return table


def expected_nft_lines(plan: dict[str, Any]) -> tuple[str, ...]:
    commands = plan.get("commands")
    if not isinstance(commands, list) or not commands:
        raise ExecutorError("confirmed nft plan has no commands")
    lines: list[str] = []
    for item in commands:
        if not isinstance(item, dict):
            raise ExecutorError("invalid command item in nft plan")
        argv = item.get("argv")
        if not isinstance(argv, list) or not argv or argv[0] != "nft" or not all(isinstance(part, str) for part in argv):
            raise ExecutorError("nft plan contains non-finite command")
        if item.get("requiresSudo") is not True or item.get("mutatesSystem") is not True:
            raise ExecutorError("nft plan command safety flags mismatch")
        lines.append(" ".join(argv[1:]))
    return tuple(lines)


def validate_nft_batch(plan: dict[str, Any], batch: str) -> str:
    if plan.get("marker") != "zap2-runtime-apply-v1" or plan.get("engine") != "nftables":
        raise ExecutorError("unsupported nft plan marker/engine")
    action = str(plan.get("action", ""))
    if action not in {"apply", "revert"}:
        raise ExecutorError("unsupported nft plan action")
    table = validate_table_name(plan.get("nftTable"))
    if not str(plan.get("ownerMarker", "")).startswith("zap2-owner:"):
        raise ExecutorError("nft plan has no valid owner marker")
    lines = tuple(line.strip() for line in batch.splitlines() if line.strip())
    if not lines:
        raise ExecutorError("empty nft batch")
    expected = expected_nft_lines(plan)
    if action == "revert":
        if lines != (f"delete table inet {table}",):
            raise ExecutorError("revert batch differs from confirmed finite plan")
        return batch

    remaining = list(lines)
    # Existing owned table may be atomically flushed instead of re-added.
    first_expected = expected[0]
    if remaining and remaining[0] == f"flush table inet {table}" and first_expected == f"add table inet {table}":
        remaining[0] = first_expected
    # Legacy migration is the only extra line runtime_apply may insert; it is
    # bounded to the historical table name for the same safe profile token.
    if remaining and remaining[0].startswith("delete table inet zap2_"):
        profile = str(plan.get("profileId", ""))
        if not SAFE_PROFILE_RE.fullmatch(profile):
            raise ExecutorError("invalid profile for legacy nft migration")
        legacy = f"delete table inet zap2_{profile}"
        if remaining[0] != legacy:
            raise ExecutorError("unexpected legacy nft delete")
        remaining.pop(0)
    if tuple(remaining) != expected:
        raise ExecutorError("apply batch differs from confirmed finite plan")
    return batch


def action_nft_observe(payload: dict[str, Any]) -> dict[str, Any]:
    table = validate_table_name(payload.get("table"))
    nft = nft_binary()
    result = command_result([str(nft), "list", "table", "inet", table])
    return {"command": result, "planHash": None}


def action_nft_plan(payload: dict[str, Any], *, check_only: bool) -> dict[str, Any]:
    plan, _confirmation, calculated = verify_plan_confirmation(payload.get("plan"), payload.get("confirmation"))
    batch = payload.get("batch")
    if not isinstance(batch, str):
        raise ExecutorError("nft batch must be text")
    validate_nft_batch(plan, batch)
    nft = nft_binary()
    argv = [str(nft), "--check", "-f", "-"] if check_only else [str(nft), "-f", "-"]
    result = command_result(argv, input_bytes=batch.encode("utf-8"))
    return {"command": result, "planHash": calculated}


def resolve_source(root: Path, rel: str) -> Path:
    """Return a lexical workspace path without resolving symlinks.

    Security-sensitive reads use openat/O_NOFOLLOW below.  Resolving here would
    erase the very symlink evidence that P02 needs to reject.
    """

    raw = Path(rel)
    if raw.is_absolute() or not raw.parts or ".." in raw.parts or "." in raw.parts:
        raise ExecutorError(f"source path leaves workspace: {rel}")
    root = root.resolve()
    return root.joinpath(*raw.parts)


def read_workspace_source_once(root: Path, rel: str) -> bytes:
    """Read one regular workspace file without following any symlink component.

    Each path component is opened relative to an already-open directory fd.
    This avoids the check-then-open parent-symlink race that a plain
    ``Path.resolve`` + final ``O_NOFOLLOW`` still permits.
    """

    raw = Path(rel)
    if raw.is_absolute() or not raw.parts or ".." in raw.parts or "." in raw.parts:
        raise ExecutorError(f"source path leaves workspace: {rel}")
    root = root.resolve()
    dir_flags = os.O_RDONLY | getattr(os, "O_DIRECTORY", 0)
    if hasattr(os, "O_NOFOLLOW"):
        dir_flags |= os.O_NOFOLLOW
    try:
        current_fd = os.open(root, dir_flags)
    except OSError as exc:
        raise ExecutorError(f"cannot open workspace root safely: {root}: {exc}") from exc
    try:
        for component in raw.parts[:-1]:
            try:
                next_fd = os.open(component, dir_flags, dir_fd=current_fd)
            except OSError as exc:
                raise ExecutorError(f"unsafe/non-directory source component: {rel}: {exc}") from exc
            os.close(current_fd)
            current_fd = next_fd
        file_flags = os.O_RDONLY
        if hasattr(os, "O_NOFOLLOW"):
            file_flags |= os.O_NOFOLLOW
        try:
            fd = os.open(raw.parts[-1], file_flags, dir_fd=current_fd)
        except OSError as exc:
            raise ExecutorError(f"cannot open runtime source without symlink following: {rel}: {exc}") from exc
        try:
            info = os.fstat(fd)
            if not stat.S_ISREG(info.st_mode):
                raise ExecutorError(f"runtime source is not a regular file: {rel}")
            chunks: list[bytes] = []
            while True:
                chunk = os.read(fd, 1024 * 1024)
                if not chunk:
                    break
                chunks.append(chunk)
            return b"".join(chunks)
        finally:
            os.close(fd)
    finally:
        try:
            os.close(current_fd)
        except OSError:
            pass


def read_source_once(path: Path) -> bytes:
    """Compatibility helper for a single already-trusted path."""

    flags = os.O_RDONLY
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        fd = os.open(path, flags)
    except OSError as exc:
        raise ExecutorError(f"cannot open runtime source without following final symlink: {path}: {exc}") from exc
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode):
            raise ExecutorError(f"runtime source is not a regular file: {path}")
        chunks: list[bytes] = []
        while True:
            chunk = os.read(fd, 1024 * 1024)
            if not chunk:
                break
            chunks.append(chunk)
        return b"".join(chunks)
    finally:
        os.close(fd)


def ensure_root_dir(path: Path, mode: int = 0o755) -> None:
    path.mkdir(parents=True, exist_ok=True)
    info = path.lstat()
    if not stat.S_ISDIR(info.st_mode) or stat.S_ISLNK(info.st_mode):
        raise ExecutorError(f"runtime bundle path is not a real directory: {path}")
    if info.st_uid != 0:
        raise ExecutorError(f"runtime bundle directory is not root-owned: {path}")
    os.chmod(path, mode)


def write_root_file(path: Path, data: bytes, mode: int) -> None:
    ensure_root_dir(path.parent)
    tmp = path.parent / f".{path.name}.{os.getpid()}.tmp"
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    fd = os.open(tmp, flags, mode)
    try:
        os.write(fd, data)
        os.fsync(fd)
        os.fchmod(fd, mode)
    finally:
        os.close(fd)
    os.replace(tmp, path)


def verified_copy(root: Path, rel: str, expected_sha: str, destination: Path, mode: int) -> None:
    data = read_workspace_source_once(root, rel)
    actual = sha256_bytes(data)
    if actual != expected_sha:
        raise ExecutorError(f"post-confirm source mutation detected: {rel}")
    write_root_file(destination, data, mode)
    if file_sha256(destination) != expected_sha:
        raise ExecutorError(f"root-owned staged copy hash mismatch: {destination}")


def artifact_map(plan: dict[str, Any]) -> tuple[dict[str, Any], dict[str, dict[str, Any]]]:
    inventory = plan.get("runtimeArtifacts")
    if not isinstance(inventory, dict) or inventory.get("schemaVersion") != 1:
        raise ExecutorError("start plan has no P02 runtimeArtifacts inventory")
    binary = inventory.get("binary")
    if not isinstance(binary, dict) or binary.get("state") != "ready" or not binary.get("sha256"):
        raise ExecutorError("confirmed start plan binary was not ready")
    if binary.get("kind") != "nfqws2-binary" or binary.get("path") != EXPECTED_NFQWS_REL:
        raise ExecutorError("confirmed start plan attempted a non-canonical executable")
    entries: dict[str, dict[str, Any]] = {}
    inputs = inventory.get("inputs")
    if not isinstance(inputs, list):
        raise ExecutorError("runtimeArtifacts.inputs must be a list")
    for item in inputs:
        if not isinstance(item, dict) or item.get("state") != "ready" or not item.get("sha256"):
            raise ExecutorError("confirmed start plan has non-ready runtime input")
        rel = str(item.get("path", ""))
        if not rel or rel in entries:
            raise ExecutorError("duplicate/empty runtime input path")
        entries[rel] = item
    return binary, entries


def rewrite_strategy_arg(arg: str, staged: dict[str, Path]) -> str:
    if "\x00" in arg or "\n" in arg or "\r" in arg:
        raise ExecutorError("runtime arg contains NUL/newline")
    if arg.startswith("--lua-init=@"):
        rel = arg[len("--lua-init=@") :]
        if rel not in staged:
            raise ExecutorError(f"lua input not bound by plan: {rel}")
        return f"--lua-init=@{staged[rel]}"
    for option in ("--hostlist", "--hostlist-exclude", "--ipset", "--ipset-exclude"):
        prefix = option + "="
        if arg.startswith(prefix):
            rel = arg[len(prefix) :].lstrip("@")
            if rel not in staged:
                raise ExecutorError(f"strategy file input not bound by plan: {rel}")
            return f"{option}={staged[rel]}"
    if arg.startswith("--blob=") and ":@" in arg:
        prefix, rel = arg.split(":@", 1)
        if rel not in staged:
            raise ExecutorError(f"blob input not bound by plan: {rel}")
        return f"{prefix}:@{staged[rel]}"
    if "@" in arg:
        raise ExecutorError(f"unclassified @file runtime argument is forbidden: {arg}")
    return arg


def proc_cmdline(pid: int) -> tuple[str, ...] | None:
    try:
        raw = (Path("/proc") / str(pid) / "cmdline").read_bytes()
    except OSError:
        return None
    return tuple(part.decode("utf-8", errors="replace") for part in raw.split(b"\0") if part)


def proc_starttime(pid: int) -> str | None:
    try:
        text = (Path("/proc") / str(pid) / "stat").read_text(encoding="utf-8", errors="replace")
    except OSError:
        return None
    close = text.rfind(")")
    if close < 0:
        return None
    fields = text[close + 2 :].split()
    return fields[19] if len(fields) > 19 else None


def process_identity(pid: int, binary_sha: str) -> dict[str, Any] | None:
    try:
        boot = Path("/proc/sys/kernel/random/boot_id").read_text(encoding="ascii").strip()
        exe = os.path.realpath(os.readlink(Path("/proc") / str(pid) / "exe"))
    except OSError:
        return None
    start = proc_starttime(pid)
    cmdline = proc_cmdline(pid)
    if not boot or not start or not exe or not cmdline:
        return None
    digest = sha256_bytes(b"\0".join(part.encode("utf-8", errors="surrogatepass") for part in cmdline))
    return {
        "bootId": boot,
        "procStartTime": start,
        "procExecutable": exe,
        "cmdlineSha256": digest,
        "binarySha256AtStart": binary_sha,
    }


def action_nfqws_start(payload: dict[str, Any]) -> dict[str, Any]:
    root_raw = payload.get("rootPath")
    if not isinstance(root_raw, str) or not root_raw.startswith("/"):
        raise ExecutorError("rootPath must be absolute")
    root = Path(root_raw).resolve()
    if not root.is_dir():
        raise ExecutorError("rootPath is not a directory")
    plan, _confirmation, calculated = verify_plan_confirmation(payload.get("plan"), payload.get("confirmation"))
    if plan.get("schemaVersion") != 1 or plan.get("stage") != EXPECTED_START_STAGE:
        raise ExecutorError("nfqws.start requires the canonical runtime start-plan schema/stage")
    if plan.get("action") != "start" or plan.get("buildTarget") != "nfqws2":
        raise ExecutorError("nfqws.start requires a confirmed nfqws2 start plan")
    if plan.get("binaryRelativePath") != EXPECTED_NFQWS_REL:
        raise ExecutorError("nfqws.start refuses arbitrary executable path")
    contract = plan.get("contract")
    if not isinstance(contract, dict):
        raise ExecutorError("nfqws.start requires embedded runtime contract")
    if contract.get("action") != "start" or contract.get("profileId") != plan.get("profileId") or contract.get("strategyId") != plan.get("strategyId"):
        raise ExecutorError("embedded runtime contract does not match start plan")
    safety = contract.get("safety")
    if not isinstance(safety, dict) or safety.get("requiresOwnerConfirmation") is not True or safety.get("mayManageServiceWhenExecutedByOwner") is not False:
        raise ExecutorError("runtime contract safety fields are not canonical")
    profile = str(plan.get("profileId", ""))
    if not SAFE_PROFILE_RE.fullmatch(profile):
        raise ExecutorError("invalid profile id")
    inventory = plan.get("runtimeArtifacts")
    if not isinstance(inventory, dict):
        raise ExecutorError("start plan has no P02 runtimeArtifacts inventory")
    owner = inventory.get("owner")
    queue = inventory.get("queue")
    if not isinstance(owner, dict) or not isinstance(queue, dict):
        raise ExecutorError("runtime owner/queue evidence missing")
    uid = int(owner.get("uid", -1))
    gid = int(owner.get("gid", -1))
    qnum = int(queue.get("qnum", -1))
    if queue.get("profileId") != profile or queue.get("source") != "owner-workspace-hash":
        raise ExecutorError("runtime queue evidence does not match canonical profile policy")
    if uid < 0 or gid < 0 or not (0 <= qnum <= 65535):
        raise ExecutorError("invalid owner uid/gid or qnum")
    sudo_uid = os.environ.get("SUDO_UID")
    if sudo_uid is not None and int(sudo_uid) != uid:
        raise ExecutorError("confirmed owner uid differs from sudo invoker")

    binary, inputs = artifact_map(plan)
    owner_key = f"u{uid}"
    ensure_root_dir(RUN_BASE)
    owner_dir = RUN_BASE / owner_key
    ensure_root_dir(owner_dir)
    run_dir = owner_dir / calculated[:16]
    ensure_root_dir(run_dir)
    input_dir = run_dir / "inputs"
    ensure_root_dir(input_dir)

    binary_rel = str(binary.get("path", ""))
    binary_sha = str(binary.get("sha256", ""))
    staged_binary = run_dir / "nfqws2"
    verified_copy(root, binary_rel, binary_sha, staged_binary, 0o755)

    staged: dict[str, Path] = {}
    for index, rel in enumerate(sorted(inputs)):
        item = inputs[rel]
        suffix = Path(rel).suffix
        target = input_dir / f"{index:03d}-{str(item.get('kind', 'input')).replace('/', '-')}{suffix}"
        verified_copy(root, rel, str(item["sha256"]), target, 0o644)
        staged[rel] = target

    strategy_args = plan.get("strategyRuntimeArgs")
    if not isinstance(strategy_args, list) or not all(isinstance(item, str) for item in strategy_args):
        raise ExecutorError("start plan strategyRuntimeArgs invalid")

    stdout_log = run_dir / "nfqws2.stdout.log"
    stderr_log = run_dir / "nfqws2.stderr.log"
    args_path = run_dir / "nfqws2.args"

    # Do not delegate a writable pidfile directory to the dropped uid.  The
    # helper returns exact /proc identity and the unprivileged lifecycle owns
    # that receipt, so a pidfile would only widen the mutable root-owned tree.
    runtime_args: list[str] = [f"--qnum={qnum}", "--fwmark=0x40000000"]
    runtime_args.extend(rewrite_strategy_arg(item, staged) for item in strategy_args)
    hostlists = plan.get("hostlists")
    if not isinstance(hostlists, list):
        raise ExecutorError("start plan hostlists invalid")
    for item in hostlists:
        if not isinstance(item, dict):
            raise ExecutorError("start plan hostlist item invalid")
        rel = str(item.get("path", ""))
        target = staged.get(rel)
        if target is None:
            raise ExecutorError(f"profile hostlist not bound by runtimeArtifacts: {rel}")
        runtime_args.append(f"--hostlist={target}")
    runtime_args.append(f"--uid={uid}:{gid}")
    args_text = "\n".join(shlex.quote(item) for item in runtime_args) + "\n"
    write_root_file(args_path, args_text.encode("utf-8"), 0o600)

    stdout_handle = stdout_log.open("ab", buffering=0)
    stderr_handle = stderr_log.open("ab", buffering=0)
    try:
        process = subprocess.Popen(
            [str(staged_binary), f"@{args_path}"],
            cwd=str(run_dir),
            stdin=subprocess.DEVNULL,
            stdout=stdout_handle,
            stderr=stderr_handle,
            start_new_session=True,
            close_fds=True,
            env={"PATH": "/usr/bin:/usr/sbin", "LANG": "C", "LC_ALL": "C", "HOME": "/"},
        )
    finally:
        stdout_handle.close()
        stderr_handle.close()
    time.sleep(0.35)
    exit_code = process.poll()
    if exit_code is not None:
        tail = ""
        try:
            tail = stderr_log.read_text(encoding="utf-8", errors="replace")[-1600:]
        except OSError:
            pass
        raise ExecutorError(f"staged nfqws2 exited during grace window rc={exit_code}: {tail}")
    identity = process_identity(process.pid, binary_sha)
    if identity is None:
        try:
            os.kill(process.pid, signal.SIGTERM)
        except OSError:
            pass
        raise ExecutorError("could not capture exact process identity after privileged spawn")
    return {
        "planHash": calculated,
        "process": {
            "pid": process.pid,
            "executablePath": str(staged_binary),
            "stdoutLogPath": str(stdout_log),
            "stderrLogPath": str(stderr_log),
            "debugLogPath": None,
            "identity": identity,
        },
    }


def parse_request(raw: bytes, expected_hash: str) -> tuple[str, dict[str, Any], str]:
    try:
        data = json.loads(raw.decode("utf-8"))
    except Exception as exc:
        raise ExecutorError(f"invalid request JSON: {exc}") from exc
    if not isinstance(data, dict) or data.get("schemaVersion") != SCHEMA_VERSION or data.get("protocol") != PROTOCOL:
        raise ExecutorError("unsupported privilege request schema/protocol")
    supplied_hash = str(data.get("requestHash", ""))
    body = {key: value for key, value in data.items() if key != "requestHash"}
    calculated = sha256_bytes(stable_json(body).encode("utf-8"))
    if supplied_hash != calculated or expected_hash != calculated:
        raise ExecutorError("request hash mismatch")
    action_id = str(data.get("actionId", ""))
    payload = data.get("payload")
    if not isinstance(payload, dict):
        raise ExecutorError("request payload must be an object")
    return action_id, payload, calculated


def execute(action_id: str, payload: dict[str, Any]) -> dict[str, Any]:
    if action_id == "nft.observe-table":
        return action_nft_observe(payload)
    if action_id == "nft.check-confirmed-plan":
        return action_nft_plan(payload, check_only=True)
    if action_id == "nft.execute-confirmed-plan":
        return action_nft_plan(payload, check_only=False)
    if action_id == "nfqws.start-confirmed-plan":
        return action_nfqws_start(payload)
    raise ExecutorError(f"unsupported finite actionId: {action_id}")


def emit(data: dict[str, Any]) -> None:
    sys.stdout.write(stable_json(data) + "\n")
    sys.stdout.flush()


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(add_help=True)
    parser.add_argument("--self-test", action="store_true")
    parser.add_argument("--execute", action="store_true")
    parser.add_argument("--request-hash", default="")
    args = parser.parse_args(argv)
    try:
        require_root_owned_helper()
        helper = helper_provenance()
        if args.self_test:
            emit({"ok": True, "actionId": "self-test", "helper": helper, "message": "bounded executor root/provenance checks passed"})
            return 0
        if not args.execute or not args.request_hash:
            raise ExecutorError("use --execute --request-hash <sha256> or --self-test")
        raw = sys.stdin.buffer.read(4 * 1024 * 1024 + 1)
        if len(raw) > 4 * 1024 * 1024:
            raise ExecutorError("request exceeds 4 MiB limit")
        action_id, payload, request_hash = parse_request(raw, args.request_hash)
        result = execute(action_id, payload)
        receipt = {
            "ok": True,
            "schemaVersion": SCHEMA_VERSION,
            "protocol": PROTOCOL,
            "actionId": action_id,
            "requestHash": request_hash,
            "helper": helper,
            **result,
        }
        emit(receipt)
        command = receipt.get("command")
        if isinstance(command, dict) and int(command.get("returncode", 0)) != 0:
            return int(command.get("returncode", 1)) or 1
        return 0
    except Exception as exc:
        try:
            helper = helper_provenance()
        except Exception:
            helper = {"version": VERSION, "path": str(helper_path())}
        emit({"ok": False, "schemaVersion": SCHEMA_VERSION, "protocol": PROTOCOL, "actionId": "error", "requestHash": args.request_hash, "helper": helper, "message": str(exc)})
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
