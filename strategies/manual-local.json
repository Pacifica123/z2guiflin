  "philosophy": "toolbox/apothecary",
  "presetPath": "presets/workspace/manual-local.txt",
  "runtimeArgs": [
    "--lua-init=@core/zapret2/lua/zapret-lib.lua",
    "--lua-init=@core/zapret2/lua/zapret-antidpi.lua",
    "--filter-tcp=80,443",
    "--filter-l7=tls,http",
    "--payload=tls_client_hello",
    "--lua-desync=fake:blob=fake_default_tls:tcp_md5",
    "--payload=http_req",
    "--lua-desync=fake:blob=fake_default_http:tcp_md5",
    "--payload=tls_client_hello,http_req",
    "--lua-desync=multisplit:pos=1:seqovl=5:seqovl_pattern=0x1603030000"
  ],
  "schemaVersion": 1,
  "sourcePreset": {
    "engine": "winws2",
    "id": "windows-default-v1-game-filter",
